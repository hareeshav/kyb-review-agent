# Copy to .env and fill in. Nothing here is required until you run approaches A/B/C or the judge.

# Generation model (cohort key)
OPENAI_API_KEY=
KYB_GEN_MODEL=gpt-4.1-mini

# Embeddings: "fastembed" (local, no key, default) or "openai" (text-embedding-3-small)
KYB_EMBEDDINGS=fastembed

# Judge: "anthropic" (different model family, preferred) or "openai" (stronger OpenAI model)
KYB_JUDGE_PROVIDER=openai
KYB_JUDGE_MODEL=gpt-4.1
ANTHROPIC_API_KEY=

# Approval gate secret (any random string; used to sign human-approval tokens)
KYB_GATE_SECRET=change-me-to-a-random-string
KYB_GATE_TTL_SECONDS=600

# Agent limits
KYB_MAX_MODEL_CALLS=8
KYB_MAX_TOOL_CALLS=12
